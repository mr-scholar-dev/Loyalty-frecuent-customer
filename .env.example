# ---------------------------------------------------------------------------
# Loyalty Web — environment variables (example)
# Copy to `.env` (or `.env.local`) and fill in real values. NEVER commit `.env`.
# Values here are placeholders only.
# ---------------------------------------------------------------------------

# Public base URL of the app (used for absolute links, QR URLs, metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Ventas manuales por WhatsApp (público) ---
# Número en formato internacional, sin +, espacios ni guiones.
NEXT_PUBLIC_WHATSAPP_NUMBER=50661511306
NEXT_PUBLIC_WHATSAPP_MESSAGE=¿Cuáles son los métodos de pago? Me interesa activar el Plan Pro de $65 USD.

# --- Supabase ---
# From Project Settings -> API. Publishable key is browser-safe.
NEXT_PUBLIC_SUPABASE_URL=https://your-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. NEVER expose to the browser. Bypasses RLS — server code only.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Security ---
# Secret used to hash public membership tokens before storage.
TOKEN_HASH_SECRET=change-me-with-a-long-random-string
# Secret used by rate limiting.
RATE_LIMIT_SECRET=change-me-with-a-long-random-string

# --- Stripe (legacy billing) — server-only. No se usa para ventas nuevas. ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Observability (disabled until needed) ---
# Leave empty to keep Sentry off.
SENTRY_DSN=
