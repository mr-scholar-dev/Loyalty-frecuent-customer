# ---------------------------------------------------------------------------
# Loyalty Web — environment variables (example)
# Copy to `.env` (or `.env.local`) and fill in real values. NEVER commit `.env`.
# Values here are placeholders only.
# ---------------------------------------------------------------------------

# Public base URL of the app (used for absolute links, QR URLs, metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# Client-side (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Server-only. NEVER expose to the browser. Bypasses RLS — server code only.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# --- Security ---
# Secret used to hash public membership tokens before storage.
TOKEN_HASH_SECRET=change-me-with-a-long-random-string
# Secret used by rate limiting.
RATE_LIMIT_SECRET=change-me-with-a-long-random-string

# --- Observability (disabled until needed) ---
# Leave empty to keep Sentry off.
SENTRY_DSN=
